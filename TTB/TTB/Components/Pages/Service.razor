@page "/service"



<PageTitle>Service</PageTitle>

@if (Id == null)
{
	<AuthorizeView Roles="admin, service">
		<Authorized>
			<AuthAddService />
		</Authorized>
	</AuthorizeView>
}
else
{
	<AuthorizeView Roles="admin, service">
		<NotAuthorized>
			<NotAuthServiceExample Id="@Id" />
		</NotAuthorized>
		<Authorized>
			<AuthEditService Id="@Id" Tab="@Tab" />
		</Authorized>
	</AuthorizeView>
}


@code {

	[Parameter]
	[SupplyParameterFromQuery]
	public int? Id { get; set; } = null;

	[Parameter]
	[SupplyParameterFromQuery]
	public string Tab { get; set; } = "";

}

