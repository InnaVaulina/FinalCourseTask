@inject HttpRequestSender HttpRequestSender
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@if (Model is null)
{
    <div class="blog-root">
        <header class="blog-header">
            <h1 class="blog-title">Контакты</h1>
        </header>
        <div>Загрузка...</div>
    </div>
}
else
{
    <div class="blog-root">
        <header class="blog-header">
            <h1 class="blog-title">Контакты</h1>

        </header>

        <main>
            <ol class="list-with-checked-items">
                @foreach (var item in contactItems)
                {
                    <li>
                        <NotAuthContactItem Model="@item" />
                    </li>
                }
            </ol>
        </main>
    </div>
}

<style>
    .blog-root {
        max-width: 2200px;
        margin: 16px;
    }

    .blog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #b2d8d8;
        padding: 8px 0;
    }

    .blog-title {
        color: CadetBlue;
        font-size: 22px;
        margin: 0;
    }


   

</style>

@code {
    ContactListDM? Model = null;

    List<ContactExampleDM> contactItems { get { return Model.DMList; } }

    protected override async Task OnInitializedAsync()
    {
        Model = new ContactListDM(new ContactsRequestSender(HttpRequestSender));        
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Model.SetListAsync();
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                NavigationManager.NavigateTo($"/Error/{ex}");
            }
            
        }

    }


}
