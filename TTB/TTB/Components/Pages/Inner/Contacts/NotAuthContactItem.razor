@using TTB.Client.Pages.Inner.SVGComponents



@if (Model is null)
{
    <div class="blog-card">
        <div>Загрузка...</div>
    </div>
}
else
{
    <div class="checked-item">
        <input type="checkbox" name="tab-btn" id="tab-btn-single-@Id">
        <label for="tab-btn-single-@Id" class="tittle-input-label">
            <Checkmark />
        </label>

        <div class="checked-item-content">
            <h2 class="checked-item-title">@Title</h2>
            <section>
                <ContactExample Model="@Model" />
            </section>
        </div>

    </div>
}


@code {

    [Parameter]
    public ContactExampleDM? Model { get; set; } = null;

    int Id { get { return Model.Content.ID; } }

    string Title { get { return Model.Content.Name; } }
    

}
