

<div class="uc-header">

    @if (Model.Count > 0)
    {
        <ol class="ol-list">
            @foreach (var linkdm in Model)
            {
                <li class="list-item">
                    <AddLink Model="linkdm"/>

                    <div class="card-actions">
                        <button class="btn delete" @onclick="@(e => DeleteLink(linkdm))">✖</button>
                    </div>
                </li>
            }
        </ol>
    }

    <div class="header-top">

        <div class="header-spacer"></div>

        <button class="save-btn" @onclick="AddLinkArea">
            <span class="save-inner">Добавить ссылку</span>
        </button>
    </div>
</div>

<style>
    .ol-list {
        list-style-type: none;
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: flex-start;
    }

    .list-item {
        display: flex;
        flex-direction: row;
    }

</style>

@code {
    [Parameter]
    public List<ContactLinkDM> Model { get; set; } = null;

    int nextId = 1;

    void DeleteLink(ContactLinkDM link)
    {
        Model.Remove(link);
        StateHasChanged();
    }

    void AddLinkArea()
    { 
        Model.Add(new ContactLinkDM(){ Link = new ContactSocialLink() { SocialLink = "", ID = nextId, IkonFileName = "" } });
        nextId++;
        StateHasChanged();
    }
}
