@inject HttpRequestSender HttpRequestSender
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@if (Model is null)
{
    <div class="blog-root">
        <header class="blog-header">
            <h1 class="blog-title">Услуги</h1>

        </header>
        <div>Загрузка...</div>
    </div>
}
else
{
    <div class="blog-root">
        <header class="blog-header">
            <h1 class="blog-title">Услуги</h1>

        </header>

        <main class="blog-list">
            @foreach (var item in Model.IserviceItemVMs)
            {
                <NotAuthServiceItem Model="@item" />
            }
        </main>
    </div>
}

<style>
    .blog-root {
        max-width: 2200px;
        margin: 16px;
    }

    .blog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #b2d8d8;
        padding: 8px 0;
    }

    .blog-title {
        color: CadetBlue;
        font-size: 22px;
        margin: 0;
    }

    .blog-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: flex-start;
    }

</style>

@code {
    NotAuthServiceListVM? Model = null;


    protected override async Task OnInitializedAsync()
    {
        var serviceDM = new ServiceListDM(new ServiceRequestSender(HttpRequestSender));
        Model = new NotAuthServiceListVM(serviceDM);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {
            try
            {
                await Model.SetListAsync();
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                NavigationManager.NavigateTo($"/Error/{ex}");
            }
        }

    }


}
