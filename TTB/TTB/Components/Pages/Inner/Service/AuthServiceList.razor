@inject HttpRequestSender HttpRequestSender
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@if (Model is null)
{
    <div class="blog-root">
        <header class="blog-header">
            <h1 class="blog-title">Услуги</h1>

        </header>
        <div>Загрузка...</div>
    </div>
}
else
{
    <div class="blog-root">
        <header class="blog-header">
            <h1 class="blog-title">Услуги</h1>

           
        </header>

        <div class="blog-actions">
            <button class="add-post" @onclick="OnAddPost">Добавить услугу</button>
        </div>

        <main class="blog-list">
            @foreach (var item in Model.ServiceItemVMs)
            {
                <AuthServiceItem Model="@item" />
            }
        </main>
    </div>
}

<style>
    .blog-root {
        max-width: 2200px;
        margin: 16px;
    }

    .blog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #b2d8d8;
        padding: 8px 0;
    }

    .blog-title {
        color: CadetBlue;
        font-size: 22px;
        margin: 0;
    }

    .add-post {
        background: CadetBlue;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        cursor: pointer;
    }

    .blog-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: flex-start;
    }

 
</style>

@code {
    AuthServiceListVM? Model = null;



    protected override async Task OnInitializedAsync()
    {
        var serviceDM = new ServiceListDM(new ServiceRequestSender(HttpRequestSender));
        Model = new AuthServiceListVM(serviceDM);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Model.SetListAsync();
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                NavigationManager.NavigateTo($"/Error/{ex}");
            }
        }

    }

    private void OnAddPost()
    {
        NavigationManager.NavigateTo("/service");
    }
}
