@inject HttpRequestSender HttpRequestSender
@inject NavigationManager NavigationManager



@if (Model is null)
{
    <section class="hero_section">
        <div>Загрузка...</div>
    </section>
}
else
{

    <div class="uc-header">
        <BlogEditor Model="@Model" />
        <div class="header-top">
            
            <div class="header-spacer"></div>

            <button class="save-btn" @onclick="HandleSave" disabled="@IsBusy">
                <span class="save-inner">@(IsBusy ? "Сохраняю..." : "Сохранить")</span>
            </button>
            <button class="save-btn" @onclick="HandleBack">
                <span class="save-inner">Назад</span>
            </button>

        </div>
    </div>
}

@code{
    public AddNewBlogExampleDM Model { get; set; } = null;


    protected override async Task OnInitializedAsync()
    {
        Model = new AddNewBlogExampleDM(new BlogRequestSender(HttpRequestSender));
    }

    private bool IsBusy { get; set; } = false;

    private async Task HandleSave()
    {
        if (IsBusy) return;
        int? postId = null;

        IsBusy = true;
        try
        {
            Model.Content.PostDate = DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss");
            var response = await Model.CreateBlogContentAsync();
            HttpResponseMessageDeserialize<int> jsonSerializer;
            jsonSerializer = new HttpResponseMessageDeserialize<int>();
            postId = await jsonSerializer.DeserealizeResultToContentAsync(response);
        }
        catch (Exception ex)
        {
            NavigationManager.NavigateTo($"/Error/{ex}");
        }
        finally
        {
            IsBusy = false;
            if (postId != null)
            {
                NavigationManager.NavigateTo($"/post?Id={postId}&Tab=Show");
            }
        }
    }

    private void HandleBack()
    {
        NavigationManager.NavigateTo("/blog");
    }

}