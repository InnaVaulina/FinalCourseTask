@inject NavigationManager NavigationManager
@inject HttpRequestSender HttpRequestSender

<PostExample Model="@Model" />

@code {
    [Parameter]
    public int? Id { get; set; } = null;
    BlogExampleDM? Model = null;

    protected override async Task OnInitializedAsync()
    {
        if (Id != null)
        {
            try
            {
                Model = await BlogExampleDM.CreateAsync(new BlogRequestSender(HttpRequestSender), Id.Value);
            }
            catch (Exception ex)
            {
                NavigationManager.NavigateTo($"/Error/{ex}");
            }
        }
    }
}
