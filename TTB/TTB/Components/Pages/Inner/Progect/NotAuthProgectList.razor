@inject HttpRequestSender HttpRequestSender
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@if (Model is null)
{
    <div class="blog-root">
        <header class="blog-header">
            <h1 class="blog-title">Проекты</h1>

        </header>
        <div>Загрузка...</div>
    </div>
}
else
{
    <div class="blog-root">
        <header class="blog-header">
            <h1 class="blog-title">Проекты</h1>

            <div class="header-controls">
                
                @if (Page == 1 && TotalPages > 1)
                {
                    @Page
                    <span>..</span>
                    <button @onclick="OnNextPage">&#8680;</button>
                }


                @if (Page == TotalPages && TotalPages > 1)
                {
                    <button @onclick="OnPreviousPage">&#8678;</button>
                    <span>..</span>
                    @Page
                }

                @if (Page > 1 && Page < TotalPages && TotalPages > 2)
                {
                    <button @onclick="OnPreviousPage">&#8678;</button>
                    <span>..</span>
                    @Page
                    <span>..</span>
                    <button @onclick="OnNextPage">&#8680;</button>
                }

            </div>
        </header>

        <main class="blog-list">
            @foreach (var item in progectItems)
            {
                <NotAuthProgectItem Model="@item" />
            }
        </main>
    </div>
}

<style>
    .blog-root {
        max-width: 2200px;
        margin: 16px;
    }

    .blog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #b2d8d8;
        padding: 8px 0;
    }

    .blog-title {
        color: CadetBlue;
        font-size: 22px;
        margin: 0;
    }

    .header-controls {
        display: flex;
        gap: 8px;
    }

    .date-input {
        height: 32px;
    }

    .blog-actions {
        display: flex;
        justify-content: flex-end;
        margin: 10px 0;
    }

    .add-post {
        background: CadetBlue;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        cursor: pointer;
    }

    .blog-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: flex-start;
    }

    .header-filter-button {
        display: block;
        background: none;
        border: none;
        cursor: pointer;
    }

    .header-filter {
        display: none;
        position: relative;
        border: 1px solid #ccc;
        padding-left: 10px;
        padding-right: 10px;
    }

</style>

@code {
    private ProgectListDM? Model = null;

    private int? Page
        {
            get { return Model.Parametres.Page; }
            set { Model.Parametres.Page = value; }
        }

    private int TotalPages { get { return Model.TotalPages; } }

    private List<ProgectExampleDM> progectItems { get { return Model.DMList; } }

    string PageKey = "PageKey_forNotAuthProget";


    protected override async Task OnInitializedAsync()
    {
        Model = new ProgectListDM(new ProgectRequestSender(HttpRequestSender));
        Model.Parametres.Search = "ShowPublished";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {
            string pageKey = await JS.InvokeAsync<string>("localStorage.getItem", PageKey);

            if (pageKey != null)
            {
                Page = int.Parse(pageKey);
            }

            try
            {
                await Model.SetListAsync();
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                NavigationManager.NavigateTo($"/Error/{ex}");
            }
        }

    }

    protected async Task OnNextPage()
    {
        Page++;
        try
        {
            await JS.InvokeAsync<string>("localStorage.setItem", PageKey, Page?.ToString());

            await Model.SetListAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            NavigationManager.NavigateTo($"/Error/{ex}");
        }
    }

    protected async Task OnPreviousPage()
    {
        Page--;
        try
        {
            await JS.InvokeAsync<string>("localStorage.setItem", PageKey, Page?.ToString());

            await Model.SetListAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            NavigationManager.NavigateTo($"/Error/{ex}");
        }
    }



    protected async Task OnSearchOptionChanged()
    {
        Page = 1;
        try
        {
            await JS.InvokeAsync<string>("localStorage.setItem", PageKey, Page?.ToString());

            await Model.SetListAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            NavigationManager.NavigateTo($"/Error/{ex}");
        }
    }

    private async Task OnHideFilters()
    {
        if (JS != null)
        {
            await JS.InvokeVoidAsync("hideFilters");
        }
    }

    private async Task OnShowFilters()
    {
        if (JS != null)
        {
            await JS.InvokeVoidAsync("showFilters");
        }
    }
}
