@inject NavigationManager NavigationManager

<style>
    .post-title {
        font-size: 20px;
        font-weight: 600;
        margin-top: 6px;
        border: none;
        border-bottom: 1px solid BlueViolet;
        display: flex;
        justify-content: space-between;
    }

    .post-date {
        font-size: 12px;
        color: gray;
        text-align: left;
        margin-bottom: 6px;
    }

    

    .content-wrapper {
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    .left-col {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: 8px;
    }

    .right-col {
        display: flex;
        gap: 8px;
    }

    .card-media {
        width: 150px;
        height: 50px;
        overflow: hidden;
        border-radius: 4px;
        border: 1px solid #8a2be2;
        margin: 5px;
    }

    .card-illustration {
        width: 100%;
        height: 100%;
    }

</style>




<div class="uc-header">

    @if (Model is null)
    {
        <div class="post-article">
            <div>Загрузка...</div>
        </div>
    }
    else
    {
        <article class="post-article">
            <h2 class="post-title">
                <div class="left-col">
                    @Title
                </div>
                <div class="right-col">
                    <div class="card-media">
                        <img src="@imagePath" alt="Иллюстрация" class="card-illustration" />
                    </div>
                </div>                
            </h2>

            <div class="content-wrapper">
                <div class="snippet-scroll">
                    @fragment
                </div>
            </div>
        </article>
    }
    <div class="header-top">

        <div class="header-spacer"></div>

        <button class="save-btn" @onclick="HandleBack">
            <span class="save-inner">Назад</span>
        </button>

    </div>
</div>

@code {

    [Parameter]
    public ProgectExampleDM? Model { get; set; } = null;

    private string Title { get { return Model.Content.Title; } }
    private string? imagePath { get; set; } = null;
    private RenderFragment fragment;


    protected override async Task OnParametersSetAsync()
    {
        if (Model != null)
        {
            fragment = builder => builder.AddMarkupContent(0, Model.Content.Description);
            imagePath = "img/" + Model.Content.IllustrationId;
        }
    }
    
    protected void HandleBack()
    {
        NavigationManager.NavigateTo("/progects");
    }

}
