@inject HttpRequestSender HttpRequestSender
@inject NavigationManager NavigationManager

<div class="hero-form">
	<input type="checkbox" id="openformchecker">
	<Banner Model="@showCollectionFormModel"/>
	<Form Model="@workModel" />
</div>

<style>
	.hero-form > input[type="checkbox"] {
		display: none;
	}

	.form_section {
		display: none;
	}

	.hero-form > input[type="checkbox"]:checked ~ .form_section {
		display: block;
	}

	.hero-form > input[type="checkbox"]:checked ~ .hero_section {
		display: none;
	}

	.input {
		display: flex;
		flex-direction: column;
	}
</style>

@code {
	ShowCollectionFormVM? showCollectionFormModel = null;
	SendRequestVM? workModel = null;


	protected override async Task OnInitializedAsync()
	{
		var bannersender = new CollectionFormRequestSender(HttpRequestSender);
        var formsender = new WorkRequestSender(HttpRequestSender);
		try
		{
			var showdm = await ShowCollectionFormDM.CreateAsync(bannersender);
			showCollectionFormModel = new ShowCollectionFormVM(showdm);

            var workdm = new RequestExampleDM(formsender);
            workModel = new SendRequestVM(workdm);
		}
		catch (Exception ex)
		{
			NavigationManager.NavigateTo($"/Error/{ex}");
		}
	}


}
