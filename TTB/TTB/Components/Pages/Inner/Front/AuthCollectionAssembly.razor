@inject HttpRequestSender HttpRequestSender
@inject NavigationManager NavigationManager


<div class="tabs area">
	<input type="radio" name="tab-btn" id="tab-btn-single" value="">
	<label for="tab-btn-single">Просмотр</label>

	<input type="radio" name="tab-btn" id="tab-btn-edit" value="" checked>
	<label for="tab-btn-edit">Редактирование</label>

	<section id="content-single" class="record-looking">
		<Banner Model="@showCollectionFormModel" />
	</section>

	<section id="content-edit" class="record-change">
		<CollectionFormSaveChanges Model="@editCollectionModel" ContentChanged="@(async () => await HandleContentChanged())"/>
	</section>

</div>

@code {
	EditCollectionFormDM? editCollectionModel = null;
	ShowCollectionFormDM? showCollectionFormModel = null;
	CollectionFormRequestSender? sender = null;

	protected override async Task OnInitializedAsync()
	{
		sender = new CollectionFormRequestSender(HttpRequestSender);
        try
        {
			showCollectionFormModel = await ShowCollectionFormDM.CreateAsync(sender);
			editCollectionModel = await EditCollectionFormDM.CreateAsync(sender);			
        }
        catch (Exception ex)
        {
            NavigationManager.NavigateTo($"/Error/{ex}");
        }
	}

	private async Task HandleContentChanged()
    {
		try
		{
			showCollectionFormModel = await ShowCollectionFormDM.CreateAsync(sender);
			editCollectionModel = await EditCollectionFormDM.CreateAsync(sender);
		}
		catch (Exception ex)
		{
			NavigationManager.NavigateTo($"/Error/{ex}");
		}
        StateHasChanged();
    }
}
