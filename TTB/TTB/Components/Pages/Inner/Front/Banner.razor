@rendermode InteractiveServer

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager



<style>

	.flex {
		display: flex;
	}

    .stretch {
        align-content: stretch;
    }

	.container {
		width: 1200px;
		padding: 0 15px;
		margin: 0 auto;
	}

	.hero_section {
		background-size: cover;
		background-repeat: no-repeat;
		background-position: center;
		box-sizing: border-box;
		width: calc(100vw - 250px);
		height: calc(100vh - 3.5rem);
		padding: 0 15px;
		margin: 0 auto;
		display: flex;
	}

	.hero-container {
		display: flex;
		justify-content: space-between;
	}


	.hero-content {
		padding-left: 20px;
		background-color: white;
		clip-path: polygon(0 0, 100% 0, 50% 0, 100% 70%, 70% 100%, 0 100%);
		opacity: 0.7;
		align-content: stretch;
		display: flex;
	}

	.hero-content-inside {
		padding-top: 5vh;
		padding-bottom: 5vh;
		max-width: 70%;
		flex-direction: column;
		align-content: stretch;
		box-sizing: border-box;
		display: flex;
	}

	.hero-content_2 {
		align-self: flex-end;
		display: flex;
		flex-direction: column;
		padding-top: 100px;
		padding-bottom: 50px;
		box-sizing: border-box;
	}



	.hero-descr {
		padding: 10px;
	}

		.hero-descr p {
			margin: 0;
			margin-bottom: 3vh;
			font-size: 1rem;
			line-height: 1.2;
			color: #787878;
		}

	.hero-title-place {
		padding: 10px;
		margin-bottom: 2vh;
	}

	.hero-title {
		font-weight: 300;
		font-size: 2rem;
		line-height: 1.2;
	}

	.hero-motto {
		padding: 10px;
		margin-bottom: 34px;
		align-self: flex-start;
		min-width: 100px;
	}

		.hero-motto span {
			display: inline-block;
			min-width: 1px;
			font-size: 16px;
			color: #787878;
			line-height: 155%;
		}

	.hero-wrapper {
		display: flex;
		justify-content: flex-end;
	}

	.hero-secure {
		font-size: 11px;
		line-height: 155%;
		color: #787878;
		text-transform: uppercase;
		background-image: url(../img/secure.svg);
		background-position: left center;
		background-size: 14px 17px;
		background-repeat: no-repeat;
		padding-left: 30px;
	}


	.btn {
		position: relative;
		outline: none;
		padding: 20px 10px;
		margin-bottom: 14px;
		min-width: 250px;
		background-color: #3172B9;
		border-radius: 3px;
		color: #fff;
	}

		.btn span {
			display: inline-block;
			min-width: 1px;
			font-weight: 600;
			font-size: 15px;
			text-transform: uppercase;
		}


	
</style>

@if (Model is null)
{
	<section class="hero_section" style="@HeroSectionStyle">
		<div>Загрузка...</div>
	</section>
}
else
{
	<section class="hero_section" style="@HeroSectionStyle">
		@Model.Fragment		
	</section>
}


@code {

	[Parameter]
	public ShowCollectionFormVM? Model { get; set; } = null;

	

	private string _heroImage = "";

	private string HeroSectionStyle =>
		$"background-image: linear-gradient(to right, rgba(255, 255, 255, 1.0) 0 20%, rgba(255, 255, 255, 0.0) 40%), " +
		$"radial-gradient(circle 600px at 90% bottom, rgba(255, 255, 255, 1.0), rgba(255, 255, 255, 0.0)), " +
		$"url('{_heroImage}'); background-size: cover; background-repeat: no-repeat; background-position: center;";


	private bool isInitialized = false;


	protected override void OnInitialized()
	{
		if (Model != null)
		{
			if (Model.ShowCollectionFormDM.ImagePath != "")
				_heroImage = "/img/" + Model.ShowCollectionFormDM.ImagePath + "?t=" + DateTime.UtcNow.Ticks;
			Model.ChangeModel += OnModelChange;
			isInitialized = true;
		}
	}


	protected override void OnAfterRender(bool firstRender)
	{
		if (firstRender || !isInitialized)
		{
			if (Model != null)
			{
				if (Model.ShowCollectionFormDM.ImagePath != "")
					_heroImage = "/img/" + Model.ShowCollectionFormDM.ImagePath + "?t=" + DateTime.UtcNow.Ticks;
				Model.ChangeModel += OnModelChange;
				StateHasChanged();
				isInitialized = true;

			}
		}
	}

	protected async Task OnModelChange()
	{
		if (Model.ShowCollectionFormDM.ImagePath != "")
			_heroImage = "/img/" + Model.ShowCollectionFormDM.ImagePath + "?t=" + DateTime.UtcNow.Ticks;
		StateHasChanged();
	}

}