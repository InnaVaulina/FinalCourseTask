@rendermode InteractiveServer

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager



<style>

	.flex {
		display: flex;
	}

	.hero_section {
		/* Базовый стиль фона (будет переопределён инлайн-стилем при рантайме) */
		background-size: cover;
		background-repeat: no-repeat;
		background-position: center;
		width: 1200px;
		padding: 0 15px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
	}

	.hero-content {
		padding-left: 20px;
		background-color: white;
		clip-path: polygon(0 0, 100% 0, 50% 0, 100% 70%, 70% 100%, 0 100%);
		opacity: 0.7;
	}

	.hero-content-inside {
		padding-top: 100px;
		padding-bottom: 100px;
		max-width: 70%;
		flex-direction: column;
		align-content: flex-start;
	}

	.hero-content_2 {
		align-self: flex-end;
		display: flex;
		flex-direction: column;
		padding-top: 100px;
		padding-bottom: 50px;
	}



	.hero-descr {
		padding: 10px;
	}

		.hero-descr:hover {
			background-color: rgba(128, 128, 128, 0.5);
			cursor: text;
		}

		.hero-descr p {
			margin: 0;
			margin-bottom: 34px;
			font-size: 16px;
			line-height: 155%;
			color: #787878;
		}

	.hero-title-place {
		padding: 10px;
		margin-bottom: 25px;
	}

		.hero-title-place:hover {
			background-color: rgba(128, 128, 128, 0.5);
			cursor: text;
		}

	.hero-title {
		font-weight: 300;
		font-size: 40px;
		line-height: 130%;
	}

	.hero-motto {
		padding: 10px;
		margin-bottom: 34px;
		align-self: flex-start;
		min-width: 100px;
	}

		.hero-motto span {
			display: inline-block;
			min-width: 1px;
			font-size: 16px;
			color: #787878;
			line-height: 155%;
		}

		.hero-motto:hover {
			background-color: rgba(128, 128, 128, 0.5);
			cursor: text;
		}

	.hero-wrapper {
		display: flex;
		justify-content: flex-end;
	}

	.hero-secure {
		font-size: 11px;
		line-height: 155%;
		color: #787878;
		text-transform: uppercase;
		background-image: url(../img/secure.svg);
		background-position: left center;
		background-size: 14px 17px;
		background-repeat: no-repeat;
		padding-left: 30px;
	}


	.btn {
		position: relative;
		outline: none;
		padding: 20px 10px;
		margin-bottom: 14px;
		min-width: 250px;
		background-color: #3172B9;
		border-radius: 3px;
		color: #fff;
	}

		.btn span {
			display: inline-block;
			min-width: 1px;
			font-weight: 600;
			font-size: 15px;
			text-transform: uppercase;
		}

</style>

@if (Model is null)
{
	<section class="hero_section" style="@HeroSectionStyle">
		<div>Загрузка...</div>
	</section>
}
else
{

	<div class="hero_section" style="@HeroSectionStyle">
		@Model.Fragment
		
	</div>

}

@code {

	[Parameter]
	public ShowCollectionFormVM? Model { get; set; } = null;

	private string _heroImage = "";

	private string HeroSectionStyle =>
		$"background-image: linear-gradient(to right, rgba(255, 255, 255, 1.0) 0 20%, rgba(255, 255, 255, 0.0) 40%), " +
		$"radial-gradient(circle 600px at 90% bottom, rgba(255, 255, 255, 1.0), rgba(255, 255, 255, 0.0)), " +
		$"url('{_heroImage}'); background-size: cover; background-repeat: no-repeat; background-position: center;";


	private bool isInitialized = false;
	private CallHandler? _callHandler;


	protected override void OnInitialized()
	{
		if (Model != null)
		{
			if (Model.ShowCollectionFormDM.ImagePath != "")
				_heroImage = "/img/" + Model.ShowCollectionFormDM.ImagePath + "?t=" + DateTime.UtcNow.Ticks;
			Model.ChangeModel += OnModelChange;
			isInitialized = true;
		}
		_callHandler = new CallHandler(JSRuntime);
		_callHandler.Notify += OpenDialogPage;

	}


	protected override void OnAfterRender(bool firstRender)
	{
		if (firstRender || !isInitialized)
		{
			if (Model != null)
			{
				if (Model.ShowCollectionFormDM.ImagePath != "")
					_heroImage = "/img/" + Model.ShowCollectionFormDM.ImagePath + "?t=" + DateTime.UtcNow.Ticks;
				Model.ChangeModel += OnModelChange;
				StateHasChanged();
				isInitialized = true;

			}
		}
	}

	protected async Task OnModelChange()
	{
		if (Model.ShowCollectionFormDM.ImagePath != "")
			_heroImage = "/img/" + Model.ShowCollectionFormDM.ImagePath + "?t=" + DateTime.UtcNow.Ticks;
		StateHasChanged();
	}


	public async Task OpenDialogPage()
	{

	}


}