@page "/contact"



<PageTitle>Contact</PageTitle>

@if (Id == null)
{
	<AuthorizeView Roles="admin, contact">
		<Authorized>
			<AuthAddContact />
		</Authorized>
	</AuthorizeView>
}
else
{
	<AuthorizeView Roles="admin, contact">
		<Authorized>
			<AuthEditContact Id="@Id" Tab="@Tab" />
		</Authorized>
	</AuthorizeView>
}


@code {

	[Parameter]
	[SupplyParameterFromQuery]
	public int? Id { get; set; } = null;

	[Parameter]
	[SupplyParameterFromQuery]
	public string Tab { get; set; } = "";

}

