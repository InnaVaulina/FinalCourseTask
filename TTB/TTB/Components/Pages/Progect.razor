@page "/progect"



<PageTitle>Progect</PageTitle>

@if (Id == null)
{
	<AuthorizeView Roles="admin, progect">
		<Authorized>
			<AuthAddProgect />
		</Authorized>
	</AuthorizeView>
}
else
{
	<AuthorizeView Roles="admin, progect">
		<NotAuthorized>
			<NotAuthProgectExample Id="@Id" />
		</NotAuthorized>
		<Authorized>
			<AuthEditProgect Id="@Id" Tab="@Tab" />
		</Authorized>
	</AuthorizeView>
}


@code {

	[Parameter]
	[SupplyParameterFromQuery]
	public int? Id { get; set; } = null;

	[Parameter]
	[SupplyParameterFromQuery]
	public string Tab { get; set; } = "";

}

