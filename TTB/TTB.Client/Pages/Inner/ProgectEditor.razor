@rendermode InteractiveAuto

<style>
    .blog-item-add {
        margin: 20px;
        display: flex;
        flex-direction: column;
        min-height: 400px;
    }

    .title-group {
        margin-bottom: 10px;
    }

    .field-label {
        font-size: 16px;
        font-weight: 700;
        color: BlueViolet;
    }

    .title-input {
        display: block;
        width: 100%;
        height: 36px;
        font-size: 20px;
        font-weight: 600;
        margin-top: 6px;
        padding: 6px;
    }

    .title-wrapper {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: flex-start;
    }

    .left-col {
        flex-grow: 1;
        gap: 8px;
    }

    
    .right-col {
        display: flex;
        gap: 8px;
    }

    
    .illustration {
        border: 1px solid BlueViolet;
        padding: 6px;
        display: flex;
        align-items: center;
    }

        .illustration img {
            max-width: 150px;
            max-height: 50px;
            object-fit: contain;
        }

    .no-image {
        color: #888;
        font-size: 14px;
    }

</style>

@if (Model is null)
{
    <div class="post-article">
        <div>Загрузка...</div>
    </div>
}
else
{

    <div class="blog-item-add">
       

        <div class="title-wrapper">
            <!-- Левая колонка: заголовок -->
            <div class="left-col">
                <div class="title-group">
                    <label class="field-label">Заголовок</label>
                    <input @bind="Title" class="title-input" />
                </div>

            </div>
            <!-- Правая колонка: изображение -->
            <div class="right-col">
                    <div class="illustration">
                        @if (!string.IsNullOrEmpty(imagePath))
                        {
                            <img src="@imagePath" />
                        }
                        else
                        {
                            <div class="no-image">Нет изображения</div>
                        }
                    </div>
                    <Dovnload_button Design="@buttonDesign" OnChange="OnDownloadButtonChanged" />
            </div>

        </div>
        <div class="title-group">
            <label class="field-label">Содержимое поста</label>
        </div>
        <Editor ContentChanged="HandleDataChanged" Content="@description" />
        <label>
            <input type="checkbox" @bind="State">
            В работе
        </label>
    </div>
}



@code {

    [Parameter]
    public IProgectExample? Model { get; set; } = null;

    private string Title
    {
        get { return Model.Content.Title; }
        set { Model.Content.Title = value; }
    }
    private string? imagePath{ get; set; } = null;


    private bool State
    {
        get
        {
            if (Model.Content.Status == "InWork") return true;
            else return false;
        }
        set
        {
            if (value == true) Model.Content.Status = "InWork";
            else Model.Content.Status = "Published";
        }
    }



    bool initialized = false;

    SVGparameters buttonDesign = new SVGparameters()
    {
        Width = "20px",
        Height = "20px",
        ColorStyle1 = "fill:CadetBlue;",
        ColorStyle2 = "fill:BlueViolet;"
    };

    string description;


    protected override async Task OnParametersSetAsync()
    {
        if (Model != null)
        {
            description = Model.Content.Description;
            imagePath = "img/" + Model.Content.IllustrationId;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || !initialized)
        {
            if (Model is null)
            {
                return;
            }
            description = Model.Content.Description;
            StateHasChanged();
            initialized = true;
        }
    }

    private void HandleDataChanged(string data)
    {
        Model.Content.Description = data;
    }

    private void OnDownloadButtonChanged(MakeImageContent makeImageContent)
    {
        if (makeImageContent is null) return;
        Model.SaveImageContent(makeImageContent.ImageFile);
        imagePath = makeImageContent.ObjectUrl;
        StateHasChanged();
    }

}