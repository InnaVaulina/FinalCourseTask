<UserControl x:Class="WpfBLazorHybridClient.Functions.Work.Control.UC_WorkMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfBLazorHybridClient.Functions.Work.Control"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Margin="20,20,20,20"
               VerticalAlignment="Stretch" HorizontalAlignment="Stretch" >

        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" Height="60"
                BorderBrush="CadetBlue">
            <DockPanel>
           
                <TextBlock DockPanel.Dock="Top" FontSize="22" FontWeight="Bold" Foreground="CadetBlue"
                HorizontalAlignment="Left" VerticalAlignment="Top">
                Обработка заявок.               
                Статус: <Run Text="{Binding SelectedStatus}"/>
                За период с <Run Text="{Binding StartTimeText}"/>
                по <Run Text="{Binding EndTimeText}"/>
                </TextBlock>

                <DockPanel DockPanel.Dock="Right">

                    <Button DockPanel.Dock="Right" IsEnabled="{Binding IsNextButtonEnabled}" 
                        Style="{StaticResource ButtonStyle}"
                        Command="{Binding GoNextPage}">
                        <Border CornerRadius="20" BorderThickness="1">
                            <Grid Height="24" Width="24" Style="{StaticResource arrowRightBackground}"/>
                        </Border>
                    </Button>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">..<Run Text="{Binding PageNumber}"/>..</TextBlock>
                    <Button DockPanel.Dock="Right" IsEnabled="{Binding IsBackButtonEnabled}"
                    Style="{StaticResource ButtonStyle}"
                    Command="{Binding GoPreviousPage}">
                        <Border CornerRadius="20" BorderThickness="1">
                            <Grid Height="24" Width="24" Style="{StaticResource arrowLeftBackground}"/>
                        </Border>
                    </Button>

                </DockPanel>
                

                <Menu DockPanel.Dock="Bottom" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent">
                    <MenuItem>
                        <MenuItem.Header>
                            <Border CornerRadius="20" BorderThickness="1">
                                <Grid Height="24" Width="24" Style="{StaticResource filterBackground}"/>
                            </Border>
                        </MenuItem.Header>
                        <MenuItem FontSize="16" Foreground="CadetBlue" StaysOpenOnClick="True">
                            <MenuItem.Header>
                                <TextBlock> 
                                    Статус: <Run Text="{Binding DesiredStatus}"/>
                                </TextBlock>
                            </MenuItem.Header>
                            <MenuItem Header="Все заявки" Command="{Binding SelectAll}" StaysOpenOnClick="True"/>
                            <MenuItem Header="Поступило" Command="{Binding SelectReceived}" StaysOpenOnClick="True"/>
                            <MenuItem Header="В работе" Command="{Binding SelectTakenOnWork}" StaysOpenOnClick="True"/>
                            <MenuItem Header="Выполнена" Command="{Binding SelectFinished}" StaysOpenOnClick="True"/>
                            <MenuItem Header="Отклонена" Command="{Binding SelectRejected}" StaysOpenOnClick="True"/>
                            <MenuItem Header="Отменена" Command="{Binding SelectCancelled}" StaysOpenOnClick="True"/>
                        </MenuItem>
                        <MenuItem FontSize="16" Foreground="CadetBlue" StaysOpenOnClick="True">
                            <MenuItem.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Начало" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <DatePicker x:Name="startDate" Grid.Column="1" SelectedDate="{Binding StartTime}"
                                        DisplayDateEnd="{Binding EndTime}" SelectedDateFormat="Short"/>
                                    <TextBlock Grid.Column="2" Text="Конец" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <DatePicker x:Name="endDate" Grid.Column="3" SelectedDate="{Binding EndTime}"
                                        DisplayDateStart="{Binding StartTime}" SelectedDateFormat="Short"/>
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem Header="Сегодня" Command="{Binding SetThatDay}" StaysOpenOnClick="True"/>
                            <MenuItem Header="Вчера" Command="{Binding SetYesterday}" StaysOpenOnClick="True"/>
                            <MenuItem Header="Неделя" Command="{Binding SetWeek}" StaysOpenOnClick="True"/>
                            <MenuItem Header="Месяц" Command="{Binding SetMonth}" StaysOpenOnClick="True"/>

                        </MenuItem>
                        <MenuItem Header="Применить фильтр" Command="{Binding UpdateList}"
                                  FontWeight="Bold" FontSize="16" Foreground="CadetBlue"/>
                        <MenuItem Header="Закрыть" FontSize="12" Foreground="CadetBlue"/>

                    </MenuItem>
                </Menu>

                <Grid/>
            </DockPanel>
        </Border>

        

 
            <Grid DockPanel.Dock="Top" Margin="10,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="1" Style="{StaticResource requestHeader}">№</TextBlock>
                <TextBlock Grid.Column="2" Style="{StaticResource requestHeader}">Время заявки</TextBlock>
                <TextBlock Grid.Column="3" Style="{StaticResource requestHeader}">Имя</TextBlock>
                <TextBlock Grid.Column="4" Style="{StaticResource requestHeader}">Контакты</TextBlock>
                <TextBlock Grid.Column="5" Style="{StaticResource requestHeader}">Тема</TextBlock>
                <TextBlock Grid.Column="6" Style="{StaticResource requestHeader}">Статус</TextBlock> 

            </Grid>



        <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Auto">

                <ListBox ItemsSource="{Binding List}"                    
                    BorderThickness="0,0,0,0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="10,10,10,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </ScrollViewer>




    </DockPanel>
</UserControl>
