<UserControl x:Class="WpfBLazorHybridClient.Functions.Work.Control.UC_RequestItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfBLazorHybridClient.Functions.Work.Control"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000">
    <UserControl.Resources>
        <Style x:Key="requestBackgroundColorStile">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=arrowDownButton, Path=Visibility}" Value="Visible">
                    <Setter Property="Control.Foreground" Value="White" />
                    <Setter Property="Control.Background" Value="CadetBlue" />
                    <Setter Property="Control.BorderBrush" Value="CadetBlue" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ElementName=arrowUpButton, Path=Visibility}" Value="Visible">
                    <Setter Property="Control.Foreground" Value="CadetBlue" />
                    <Setter Property="Control.Background" Value="White" />
                    <Setter Property="Control.BorderBrush" Value="CadetBlue" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="800"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="10" 
        x:Name="serviseElement"
        Style="{StaticResource requestBackgroundColorStile}"
        BorderThickness="1" 
        >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>




                <Button Grid.Column="0" Grid.Row="0"
                        x:Name="arrowDownButton"
                        Width="40" Height="40"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderThickness="0" 
                        Click="arrowDownButton_Click"
                        Style="{StaticResource ButtonStyle}">
                    <Border CornerRadius="20" BorderThickness="1">
                        <Grid Height="40" Width="40" Style="{StaticResource arrowDownBackground}"/>
                    </Border>
                </Button>



                <Button Grid.Column="0" Grid.Row="0" 
                        x:Name="arrowUpButton"
                        Width="40" Height="40" VerticalAlignment="Center"
                        BorderThickness="0" 
                        Click="arrowUpButton_Click"
                        Visibility="Hidden" 
                        Style="{StaticResource ButtonStyle}">
                    <Border CornerRadius="20" BorderThickness="1">
                        <Grid Height="40" Width="40" Style="{StaticResource arrowUpBackground}"/>
                    </Border>
                </Button>


                <TextBlock Grid.Column="1" Grid.Row="0" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="{Binding ID}"
                   />

                <TextBlock Grid.Column="2" Grid.Row="0" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="{Binding RequestIn}"
                   />

                <TextBlock Grid.Column="3" Grid.Row="0" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="{Binding ClientFullName}"
                   />

                <TextBlock Grid.Column="4" Grid.Row="0" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="{Binding Contact}"
                   />

                <TextBlock Grid.Column="5" Grid.Row="0" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="{Binding RequestText}"
                   />

                <TextBlock Grid.Column="6" Grid.Row="0" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="{Binding StatusTranslated}"
                   />

                <TextBlock Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="1" 
                   x:Name="serviseDescriptionBlock" 
                   Visibility="Collapsed"                           
                   Foreground="CadetBlue" TextWrapping="Wrap" Margin="0, 0, 0, 30"
                   Text="{Binding PerformingInfo}"
                   />

            </Grid>

        </Border >
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,5,5,5">

            <Button BorderThickness="0" Style="{StaticResource ButtonStyle}"
                    Command="{Binding EditRequesteItem}">
                <Border CornerRadius="20" BorderThickness="1" Background="CadetBlue">
                    <Grid Height="40" Width="40" Style="{StaticResource editBackground}"/>
                </Border>
            </Button>

            

        </StackPanel>

    </Grid>
</UserControl>
