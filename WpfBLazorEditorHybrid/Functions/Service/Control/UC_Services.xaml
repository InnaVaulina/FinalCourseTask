<UserControl x:Class="WpfBLazorHybridClient.Functions.Service.Control.UC_Services"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfBLazorHybridClient.Functions.Service.Control"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Margin="20,20,20,20"
               VerticalAlignment="Stretch" HorizontalAlignment="Stretch" >

        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" Height="50"
                BorderBrush="CadetBlue">
            
                <TextBlock FontSize="22" FontWeight="Bold" Foreground="CadetBlue"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                    Что мы можем сделать
                </TextBlock>

           
        </Border>
        <StackPanel DockPanel.Dock="Bottom">

            <Button BorderThickness="0" Style="{StaticResource ButtonStyle}"
                    Margin="5,5,5,5" VerticalAlignment="Center" HorizontalAlignment="Right"
                    Command="{Binding OpenAddPage}">
                <Border CornerRadius="10" BorderThickness="1" Background="CadetBlue">
                    <Grid Height="40" Width="180" >
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="16" FontWeight="Bold" Foreground="White">
                            Добавить услугу
                        </TextBlock>
                    </Grid>
                </Border>
            </Button>
            
        </StackPanel>

        

        <ScrollViewer  DockPanel.Dock="Left"                     
                      CanContentScroll="True">
            <ListBox ItemsSource="{Binding List}"                    
                 BorderThickness="0,0,0,0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="10,10,10,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>



            </ListBox>
        </ScrollViewer>

        
        
    </DockPanel>
</UserControl>
