<UserControl x:Class="WpfBLazorHybridClient.Functions.Admin.Control.UC_Registration2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfBLazorHybridClient.Functions.Admin.Control"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Margin="20,20,20,20"
       VerticalAlignment="Stretch" HorizontalAlignment="Stretch" >

        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" Height="50"
        BorderBrush="CadetBlue">

            <TextBlock FontSize="22" FontWeight="Bold" Foreground="CadetBlue"
            HorizontalAlignment="Left" VerticalAlignment="Center">
            Регистрация пользователя
            </TextBlock>


        </Border>
        <StackPanel DockPanel.Dock="Bottom">

            <Button BorderThickness="0" Style="{StaticResource ButtonStyle}"
            Margin="5,5,5,5" VerticalAlignment="Center" HorizontalAlignment="Right"
            Command="{Binding RegUser}">
                <Border CornerRadius="10" BorderThickness="1" Background="CadetBlue">
                    <Grid Height="40" Width="220" >
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                        FontSize="16" FontWeight="Bold" Foreground="White">
                            Зарегистрировать
                        </TextBlock>
                    </Grid>
                </Border>
            </Button>

        </StackPanel>



        <ScrollViewer  DockPanel.Dock="Left" CanContentScroll="True">
            <Grid Margin="20, 20, 20, 20" Width="500">
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="20" Height="20"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition MinHeight="20" Height="20"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition MinHeight="20" Height="20"/>

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Логин"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Пароль"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Подтверждение пароля"/>

                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LoginProp}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Password}"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ConfirmPassword}"/>

            </Grid>
        </ScrollViewer>



    </DockPanel>
</UserControl>
