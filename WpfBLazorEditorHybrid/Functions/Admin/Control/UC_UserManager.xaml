<UserControl x:Class="WpfBLazorHybridClient.Functions.Admin.Control.UC_UserManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfBLazorHybridClient.Functions.Admin.Control"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Margin="20,20,20,20"
           VerticalAlignment="Stretch" HorizontalAlignment="Stretch" >

        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" Height="50"
            BorderBrush="CadetBlue">

            <TextBlock FontSize="22" FontWeight="Bold" Foreground="CadetBlue"
                HorizontalAlignment="Left" VerticalAlignment="Center">
                Управление пользователями
            </TextBlock>
        </Border>

        <ScrollViewer  DockPanel.Dock="Left"                     
                  CanContentScroll="True">
            <ListBox  ItemsSource="{Binding List}"                    
                    BorderThickness="0,0,0,0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="10,10,10,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </ScrollViewer>



    </DockPanel>
</UserControl>
