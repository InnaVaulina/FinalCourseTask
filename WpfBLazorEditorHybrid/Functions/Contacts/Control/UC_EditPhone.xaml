<UserControl x:Class="WpfBLazorHybridClient.Functions.Contacts.Control.UC_EditPhone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfBLazorHybridClient.Functions.Contacts.Control"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Top"
            BorderThickness="0" Style="{StaticResource ButtonStyle}"
            Command="{Binding DislikeText}">
            <Border CornerRadius="15" BorderThickness="1" Background="CadetBlue">
                <Grid Height="30" Width="30" Style="{StaticResource deleteBackground}"/>
            </Border>
        </Button>

        <Button DockPanel.Dock="Right" VerticalAlignment="Top"
            BorderThickness="0" Style="{StaticResource ButtonStyle}"
            x:Name="editTextButton" Click="editText_Click"
            Command="{Binding EditText}">
            <Border CornerRadius="15" BorderThickness="1" Background="CadetBlue">
                <Grid Height="30" Width="30" Style="{StaticResource editBackground}"/>
            </Border>
        </Button>

        <Button DockPanel.Dock="Right" VerticalAlignment="Top" 
            BorderThickness="0" Style="{StaticResource ButtonStyle}"
            x:Name="likeTextButton" Click="likeText_Click"
            Command="{Binding LikeText}">
            <Border CornerRadius="15" BorderThickness="1" Background="CadetBlue">
                <Grid Height="30" Width="30" Style="{StaticResource likeBackground}"/>
            </Border>
        </Button>

        <TextBlock x:Name="showText" DockPanel.Dock="Top"           
            Text="{Binding PhoneText}" 
            MinWidth="200" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="5" TextWrapping="Wrap"/>

        <TextBox  x:Name="editText" DockPanel.Dock="Top"           
            Text="{Binding Text}" 
            MinWidth="200" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="5" TextWrapping="Wrap"/>
    </DockPanel>
</UserControl>
