<UserControl x:Class="WpfBLazorHybridClient.Functions.Contacts.Control.UC_Phone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfBLazorHybridClient.Functions.Contacts.Control"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel DockPanel.Dock="Left" VerticalAlignment="Top" Margin="5">
        <StackPanel Margin="40,10">
            <ListBox x:Name="phoneList" ItemsSource="{Binding Phones}"
              BorderThickness="0" 
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <local:UC_EditPhone DataContext="{Binding}" Style="{StaticResource editParagraphText}"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <DockPanel>
                <Button VerticalAlignment="Top" HorizontalAlignment="Left"
                    BorderThickness="0" Style="{StaticResource ButtonStyle}"
                    x:Name="addTextButton" Click="addTextButton_Click"
                    Command="{Binding AddPhonePanel}">
                    <Border CornerRadius="15" BorderThickness="1" Background="CadetBlue">
                        <Grid Height="20" Width="20" Margin="5" Style="{StaticResource addBackground}"/>
                    </Border>
                </Button>

                <DockPanel x:Name="addParagraphPanel">
                    <Button DockPanel.Dock="Right" x:Name="likeTextButton" 
                    Click="likeTextButton_Click" Command="{Binding LikeText}"
                    BorderThickness="0" Margin="5,5,5,5" Style="{StaticResource ButtonStyle}">
                        <Border CornerRadius="20" BorderThickness="1" Background="CadetBlue">
                            <Grid Height="30" Width="30" Style="{StaticResource likeBackground}"/>
                        </Border>
                    </Button>

                    <TextBox Text="{Binding Text}" Height="30" VerticalAlignment="Center" Margin="5" TextWrapping="Wrap"/>
                </DockPanel>

            </DockPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
