<UserControl x:Class="WpfBLazorHybridClient.Functions.Contacts.Control.UC_ContactItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfBLazorHybridClient.Functions.Contacts.Control"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="700">
    <UserControl.Resources>
        <Style x:Key="serviseBackgroundColorStile">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=arrowDownButton, Path=Visibility}" Value="Visible">
                    <Setter Property="Control.Foreground" Value="White" />
                    <Setter Property="Control.Background" Value="CadetBlue" />
                    <Setter Property="Control.BorderBrush" Value="CadetBlue" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ElementName=arrowUpButton, Path=Visibility}" Value="Visible">
                    <Setter Property="Control.Foreground" Value="CadetBlue" />
                    <Setter Property="Control.Background" Value="White" />
                    <Setter Property="Control.BorderBrush" Value="CadetBlue" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>
    <Grid>
        <Border CornerRadius="10" 
            x:Name="serviseElement"
            Style="{StaticResource serviseBackgroundColorStile}"
            BorderThickness="1" 
            >   
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="490"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>




                <Button Grid.Column="0" Grid.Row="0"
                x:Name="arrowDownButton"
                Width="40" Height="40"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderThickness="0" 
                Click="arrowDownButton_Click"
                Style="{StaticResource ButtonStyle}">
                    <Border CornerRadius="20" BorderThickness="1">
                        <Grid Height="40" Width="40" Style="{StaticResource arrowDownBackground}"/>
                    </Border>
                </Button>



                <Button Grid.Column="0" Grid.Row="0" 
                x:Name="arrowUpButton"
                Width="40" Height="40" VerticalAlignment="Center"
                BorderThickness="0" 
                Click="arrowUpButton_Click"
                Visibility="Hidden" 
                Style="{StaticResource ButtonStyle}">
                    <Border CornerRadius="20" BorderThickness="1">
                        <Grid Height="40" Width="40" Style="{StaticResource arrowUpBackground}"/>
                    </Border>
                </Button>


                <TextBlock Grid.Column="1" Grid.Row="0" 
                   x:Name="serviseTitleBlock"                          
                   FontWeight="Bold" FontSize="16" VerticalAlignment="Center"
                   Text="{Binding Title}"
                   />   

                <StackPanel  Grid.Column="2" Grid.Row="0"
                    Orientation="Horizontal" 
                    VerticalAlignment="Stretch" HorizontalAlignment="Right"  Margin="20,5,5,5">

                    <Button BorderThickness="0" Command="{Binding OpenEditingPage}" Style="{StaticResource ButtonStyle}">
                        <Border CornerRadius="20" BorderThickness="1" Background="Gray">
                            <Grid Height="40" Width="40" Style="{StaticResource editBackground}"/>
                        </Border>
                    </Button>

                    <Button BorderThickness="0" Command="{Binding DeleteItem}" Style="{StaticResource ButtonStyle}">
                        <Border CornerRadius="20" BorderThickness="1" Background="Gray">
                            <Grid Height="40" Width="40" Style="{StaticResource deleteBackground}"/>
                        </Border>
                    </Button>

                </StackPanel>


                <DockPanel Grid.Column="1" Grid.Row="1"
                   x:Name="serviseDescriptionBlock"
                   Background="Transparent" MinHeight="150">


                    <Border DockPanel.Dock="Right" Visibility="Collapsed"
                    x:Name="addressMapIllustration"
                    BorderBrush="BlueViolet" BorderThickness="0" Height="200" Width="250" 
                    HorizontalAlignment="Left"
                    Style="{StaticResource map2Background}">
                        <Image Source="{Binding PictureMapBitmap}" Stretch="Uniform" />
                    </Border>

                    <StackPanel>
                        <TextBlock>Адрес:<Run Text="{Binding AddressText, Mode=OneWay}"/></TextBlock>

                        <TextBlock>Телефоны:</TextBlock>
                        <ListBox ItemsSource="{Binding Phones}"                    
                        BorderThickness="0,0,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Phone}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock>Почта:</TextBlock>
                        <ListBox ItemsSource="{Binding Emails}"                    
                        BorderThickness="0,0,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Mail}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock>Социальные сети:</TextBlock>
                        <ListBox ItemsSource="{Binding Links}"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         HorizontalAlignment="Left">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="4,0,4,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </DockPanel>

            </Grid>

        </Border >

    </Grid>
</UserControl>
