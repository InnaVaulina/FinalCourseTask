<UserControl x:Class="WpfBLazorHybridClient.Functions.Contacts.Control.UC_AddAddress"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfBLazorHybridClient.Functions.Contacts.Control"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
        <Button VerticalAlignment="Top" HorizontalAlignment="Left"
                BorderThickness="0" Style="{StaticResource ButtonStyle}"
                x:Name="addTextButton" Click="addTextButton_Click"
                Command="{Binding AddAddressPanel}">
            <Border CornerRadius="15" BorderThickness="1" Background="CadetBlue">
                <Grid Height="20" Width="20" Margin="5" Style="{StaticResource addBackground}"/>
            </Border>
        </Button>

        <DockPanel x:Name="addParagraphPanel">

            <Button DockPanel.Dock="Right" VerticalAlignment="Top"
                  BorderThickness="0" Style="{StaticResource ButtonStyle}"
                  x:Name="deleteTextButton" Click="deleteTextButton_Click"
                  Command="{Binding DislikeText}">
                <Border CornerRadius="15" BorderThickness="1" Background="CadetBlue">
                    <Grid Height="30" Width="30" Style="{StaticResource deleteBackground}"/>
                </Border>
            </Button>

            <DockPanel DockPanel.Dock="Left">

                
                <Border DockPanel.Dock="Top"
                    BorderBrush="BlueViolet" BorderThickness="0" Height="200" Width="250" 
                        HorizontalAlignment="Left"
                        Style="{StaticResource map2Background}">
                    <Image Source="{Binding PictureMapBitmap}" Stretch="Uniform" />
                </Border>
                <Button DockPanel.Dock="Right" BorderThickness="0" Margin="5,5,5,0" HorizontalAlignment="Left" 
                    Style="{StaticResource ButtonStyle}"
                    Click="loadMap_Click">
                    <Border CornerRadius="20" >
                        <Grid Height="20" Width="20" Margin="2" Style="{StaticResource downloadBackground}"/>
                    </Border>

                </Button>
                <DockPanel/>

            </DockPanel>

            <DockPanel x:Name="showText" DockPanel.Dock="Top">
                

                <Button DockPanel.Dock="Right" 
                      BorderThickness="0" Style="{StaticResource ButtonStyle}"
                      x:Name="editTextButton" Click="editText_Click">
                    <Border CornerRadius="15" BorderThickness="1" Background="CadetBlue">
                        <Grid Height="30" Width="30" Style="{StaticResource editBackground}"/>
                    </Border>
                </Button>

                <TextBlock DockPanel.Dock="Top"           
                  Text="{Binding AddressText}" 
                  MinWidth="200" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="5" TextWrapping="Wrap"/>

            </DockPanel>

            <DockPanel x:Name="editText" DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" x:Name="likeTextButton" 
                    Click="likeTextButton_Click" Command="{Binding LikeText}"
                    BorderThickness="0" Margin="5,5,5,5" Style="{StaticResource ButtonStyle}">
                    <Border CornerRadius="20" BorderThickness="1" Background="CadetBlue">
                        <Grid Height="30" Width="30" Style="{StaticResource likeBackground}"/>
                    </Border>
                </Button>



                <TextBox DockPanel.Dock="Top"           
                  Text="{Binding Text}" 
                  MinWidth="200" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="5" TextWrapping="Wrap"/>

            </DockPanel>
            <DockPanel/>

        </DockPanel>

    </DockPanel>
</UserControl>
