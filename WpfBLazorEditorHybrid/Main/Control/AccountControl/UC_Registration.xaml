<UserControl x:Class="WpfBLazorHybridClient.Main.Control.AccountControl.UC_Registration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfBLazorHybridClient.Main.Control.AccountControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel VerticalAlignment="Center">
        <StackPanel Margin="50,0,50,0" Width="400">
            <TextBlock>Регистрация пользователя:</TextBlock>
            <Border BorderBrush="Black" Margin="5" BorderThickness="1" CornerRadius="10">
                <Grid Margin="20, 20, 20, 20">
                    <Grid.RowDefinitions>
                        <RowDefinition MinHeight="20" Height="20"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition MinHeight="20" Height="20"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition MinHeight="20" Height="20"/>

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="0.5*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Логин"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Пароль"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Подтверждение пароля"/>

                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LoginProp}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Password}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ConfirmPassword}"/>

                </Grid>
            </Border>
            <Button Margin="50,15,50,10" Content="Зарегистрировать" Command="{Binding RegUser}"/>
        </StackPanel>
    </DockPanel>
</UserControl>
